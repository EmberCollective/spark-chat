{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spark Chat",
  "version": "0.1.1",
  "identifier": "cn.sparknet.chat",
  "build": { "frontendDist": "web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": true,
        "title": "Spark Chat · 星星之火",
        "width": 1000,
        "height": 740,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#edf2eb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "main",
          "windows": ["main"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": {
      "nsis": { "languages": ["SimpChinese", "English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
